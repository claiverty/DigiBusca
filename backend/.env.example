# Backend: valores usados pelo servidor. Nunca use prefixo VITE_ aqui.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço, exclusivamente server-side. Nunca use VITE_ nem exponha ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Origens do DigiBusca autorizadas a usar a ponte local com o OpenBot (separe por vírgula).
DIGIBUSCA_APP_ORIGINS=https://digibusca.claiverty.workers.dev

# Chave privada do Google Places API (New).
GOOGLE_MAPS_API_KEY=

# Chave privada do Gemini API. Use um projeto configurado no Free Tier.
GEMINI_API_KEY=

# WhatsApp Business Cloud API (segredos ficam apenas no backend).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# App ID da Meta, não secreto. Deve corresponder a VITE_META_APP_ID.
META_APP_ID=
# Informe a versão do Graph API exibida pela sua configuração da Meta (ex.: vXX.X).
WHATSAPP_GRAPH_API_VERSION=
# Nome/idioma de um template de marketing aprovado, com um parâmetro de texto no corpo.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# Webhook de entrada. Obtenha estes valores nas configurações do app da Meta.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Chave AES-256 em Base64 (32 bytes decodificados), exclusiva do servidor.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
