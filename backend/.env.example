# Backend: valores usados pelo servidor. Nunca use prefixo VITE_ aqui.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave privada do Google Places API (New).
GOOGLE_MAPS_API_KEY=

# Chave privada do Gemini API. Use um projeto configurado no Free Tier.
GEMINI_API_KEY=

# WhatsApp Business Cloud API (segredos ficam apenas no backend).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Informe a versão do Graph API exibida pela sua configuração da Meta (ex.: vXX.X).
WHATSAPP_GRAPH_API_VERSION=
# Nome/idioma de um template de marketing aprovado, com um parâmetro de texto no corpo.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
