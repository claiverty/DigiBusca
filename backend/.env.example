# Backend: valores usados pelo servidor. Nunca use prefixo VITE_ aqui.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço exclusivamente server-side. Necessária para salvar eventos da Evolution.
SUPABASE_SERVICE_ROLE_KEY=

# Origens hospedadas autorizadas a chamar integrações locais (separe por vírgula).
DIGIBUSCA_APP_ORIGINS=https://digibusca.claiverty.workers.dev

# Chaves privadas das integrações.
GOOGLE_MAPS_API_KEY=
GEMINI_API_KEY=

# Evolution API local (Baileys / WhatsApp Web). Ative a integração para gerar o QR;
# automação e prospecção continuam bloqueadas pelos runtimes separados abaixo.
WHATSAPP_INTEGRATION_ENABLED=false
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET= # gere com: openssl rand -hex 32 (mínimo de 32 bytes)
EVOLUTION_WEBHOOK_URL=http://digibusca-webhook:3001/api/webhooks/evolution
PORT=3001
# O servidor do Mac fica somente em loopback. O serviço de webhook do Compose
# usa 0.0.0.0 dentro da rede Docker, sem publicar a porta no host.
HOST=127.0.0.1

# Mantenha desligados até parear o WhatsApp e revisar as regras na interface.
WHATSAPP_AUTOMATION_RUNTIME_ENABLED=false
WHATSAPP_PROSPECTING_RUNTIME_ENABLED=false
