# Copy outside the repository to /etc/digibusca/hostgator/evolution-api.env (0600).
# Keep the DB password identical to evolution-db.env; this value is URL-safe hex.
AUTHENTICATION_API_KEY=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS
DATABASE_CONNECTION_URI=postgresql://evolution:REPLACE_WITH_64_RANDOM_HEX_CHARACTERS@evolution-db:5432/evolution?schema=public
