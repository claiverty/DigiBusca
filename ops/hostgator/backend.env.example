# Copy outside the repository to /etc/digibusca/hostgator/backend.env (0600).
# Secrets below belong to the backend container only. Never mount this file into OpenBot.
SUPABASE_URL=https://REPLACE_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# The Compose service key is allowlisted by the current backend config.
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
EVOLUTION_WEBHOOK_SECRET=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS
EVOLUTION_WEBHOOK_URL=http://digibusca-backend:3001/api/webhooks/evolution

DIGIBUSCA_APP_ORIGINS=https://REPLACE_WITH_FRONTEND_HOSTNAME

# Enable authenticated connection/inbox routes so the VPS QR can be paired.
# Sending, automated replies and prospecting remain disabled until reviewed.
WHATSAPP_INTEGRATION_ENABLED=true
WHATSAPP_EVOLUTION_INTEGRATION_ENABLED=false
WHATSAPP_AUTOMATION_RUNTIME_ENABLED=false
WHATSAPP_PROSPECTING_RUNTIME_ENABLED=false
WHATSAPP_OPENBOT_REPLY_RUNTIME_ENABLED=false
WHATSAPP_OPENBOT_AGENT_SAFETY_CONFIRMED=false
WHATSAPP_OPENBOT_AGENT_ID=REPLACE_WITH_CRISTHIAN_AGENT_ID
WHATSAPP_OPENBOT_BRIDGE_URL=http://10.0.4.10:4181
WHATSAPP_OPENBOT_BRIDGE_TOKEN=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS

# Optional backend-only provider keys; leave unset until that capability is approved.
# GOOGLE_MAPS_API_KEY=REPLACE_WITH_GOOGLE_MAPS_KEY
# GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
# ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
# OPENAI_COMPATIBLE_API_KEY=REPLACE_WITH_PROVIDER_KEY
# OPENAI_COMPATIBLE_BASE_URL=https://api.provider.example/v1
# WHATSAPP_DIGIBOT_AGENT_RUNTIME_ENABLED=false
