# Copie para /etc/digibusca/hostgator/openclaw-backend.env com permissão 0600.
# Os tokens devem ser exatamente os mesmos do arquivo openclaw.env do Gateway.
# The runtime enablement is controlled by ops/hostgator/compose.yaml.
OPENCLAW_MCP_TOKEN=REPLACE_WITH_THE_SAME_MCP_TOKEN_FROM_GATEWAY_ENV
OPENCLAW_BRIDGE_TOKEN=REPLACE_WITH_THE_SAME_BRIDGE_TOKEN_FROM_GATEWAY_ENV
OPENCLAW_GATEWAY_HOOK_TOKEN=REPLACE_WITH_THE_SAME_HOOK_TOKEN_FROM_GATEWAY_ENV
OPENCLAW_GATEWAY_HOOK_URL=http://openclaw-gateway:18789/hooks/agent
OPENCLAW_CRISTHIAN_AGENT_ID=main
OPENCLAW_OWNER_USER_ID=00000000-0000-4000-8000-000000000000
OPENCLAW_PHONE_NUMBER_ID=REPLACE_WITH_THE_SAME_DIGIBUSCA_CONNECTION_ID
OPENCLAW_OPERATOR_E164=+55DDDSEUCELULAR
