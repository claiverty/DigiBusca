# Copy outside Git to /etc/digibusca/hostgator/openclaw.env and chmod 0600.
# Keep this file separate from backend.env and generate independent random tokens.
OPENCLAW_GATEWAY_TOKEN=REPLACE_WITH_A_UNIQUE_64_RANDOM_HEX_CHARACTERS
OPENCLAW_MCP_TOKEN=REPLACE_WITH_A_DIFFERENT_64_RANDOM_HEX_CHARACTERS
OPENCLAW_BRIDGE_TOKEN=REPLACE_WITH_ANOTHER_DIFFERENT_64_RANDOM_HEX_CHARACTERS
OPENCLAW_GATEWAY_HOOK_TOKEN=REPLACE_WITH_A_FOURTH_DIFFERENT_64_RANDOM_HEX_CHARACTERS
OPENCLAW_PHONE_NUMBER_ID=REPLACE_WITH_THE_DIGIBUSCA_CONNECTION_ID
OPENCLAW_OPERATOR_E164=+55DDDSEUCELULAR
OPENCLAW_CRISTHIAN_AGENT_ID=main
DIGIBUSCA_BACKEND_URL=http://digibusca-backend:3001

# Opcional apenas para a Gemini API do AI Studio, que usa cobrança/crédito Cloud.
# Não autentica a assinatura pessoal AI Pro pelo Gemini CLI. Não definir sem
# escolher essa rota e autorizar o uso da credencial.
# GEMINI_API_KEY=

# Adicione somente a chave do provedor/modelo escolhido, usando a variável
# documentada pelo OpenClaw. Mantenha credenciais reais fora do Git.
