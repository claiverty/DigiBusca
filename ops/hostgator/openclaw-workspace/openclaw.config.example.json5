{
  gateway: {
    mode: "local",
    bind: "lan",
    port: 18789,
    publicOrigin: "https://openclaw.digiuptech.com.br",
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
    },
    trustedProxies: ["10.0.12.2"],
    controlUi: {
      allowedOrigins: [
        "https://openclaw.digiuptech.com.br",
        "http://127.0.0.1:18790",
      ],
    },
  },
  agents: {
    defaults: {
      model: {
        primary: "google/gemini-4-hydrogen",
        fallbacks: ["google/gemini-3.8-flash", "google/gemini-3.5-flash-lite"],
      },
      maxConcurrent: 1,
      timeoutSeconds: 45,
    },
  },
  mcp: {
    servers: {
      digibusca: {
        url: "http://digibusca-backend:3001/mcp",
        transport: "streamable-http",
        enabled: true,
        connectionTimeoutMs: 5000,
        requestTimeoutMs: 20000,
        headers: {
          Authorization: "Bearer ${OPENCLAW_MCP_TOKEN}",
        },
        toolFilter: {
          include: [
            "get_runtime_status",
            "check_calendar_availability",
            "create_confirmed_meeting",
            "request_calendar_follow_up",
            "search_leads_without_site",
            "list_leads",
            "update_lead",
            "queue_prospect",
          ],
        },
      },
    },
  },
  plugins: {
    // Reduz a superfície e o consumo do Gateway aos provedores e integrações usados.
    allow: ["google", "whatsapp", "digibusca-sync"],
    slots: {
      memory: "none",
    },
    load: {
      paths: ["/home/node/.openclaw/extensions/digibusca-sync"],
    },
    entries: {
      whatsapp: {
        enabled: true,
      },
      "digibusca-sync": {
        enabled: true,
        hooks: {
          allowConversationAccess: true,
        },
      },
    },
  },
  channels: {
    whatsapp: {
      // Aguardar modelo autenticado antes de ativar o WhatsApp ou exibir QR.
      enabled: false,
      // Leads podem iniciar uma conversa por DM; grupos permanecem bloqueados.
      dmPolicy: "open",
      allowFrom: ["*"],
      groupPolicy: "disabled",
      selfChatMode: false,
    },
  },
  session: {
    // Cada cliente recebe seu próprio contexto de conversa.
    dmScope: "per-channel-peer",
  },
  tools: {
    // Transcreve notas de voz localmente primeiro. O OpenAI OAuth só é tentado
    // se o Whisper local falhar; não configure OPENAI_API_KEY para esta rota.
    media: {
      models: [
        {
          type: "cli",
          command: "/home/node/.openclaw/extensions/digibusca-sync/openclaw-whisper-transcribe.sh",
          args: ["{{AttachmentPath}}"],
          timeoutSeconds: 90,
          capabilities: ["audio"],
        },
        {
          provider: "openai",
          model: "gpt-4o-transcribe",
          capabilities: ["audio"],
        },
      ],
      audio: {
        enabled: true,
        language: "pt",
        echoTranscript: false,
      },
      concurrency: 1,
    },
    // Mensagens e MCP são permitidos; ferramentas de host, arquivos, web,
    // automação, sessões, agentes e administração do Gateway ficam bloqueadas.
    profile: "messaging",
    deny: [
      "group:runtime",
      "group:fs",
      "group:web",
      "group:automation",
      "group:ui",
      "group:nodes",
      "group:sessions",
      "group:agents",
      "gateway",
    ],
    toolsBySender: {
      "*": {
        deny: ["group:plugins"],
      },
      "e164:+556198636443": {
        alsoAllow: ["group:plugins"],
      },
    },
  },
  hooks: {
    enabled: true,
    path: "/hooks",
    token: "${OPENCLAW_GATEWAY_HOOK_TOKEN}",
    allowedAgentIds: ["main"],
    allowRequestSessionKey: false,
  },
}
