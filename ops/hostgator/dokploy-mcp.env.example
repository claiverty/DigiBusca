# Copy outside the repository to /etc/digibusca/hostgator/dokploy-mcp.env (root:root, 0600).
# Create a dedicated Dokploy Member and restrict it to the DigiBusca project/environment.
DOKPLOY_URL=http://dokploy:3000
DOKPLOY_API_KEY=REPLACE_WITH_DEDICATED_MEMBER_API_KEY

# The HTTP endpoint is reachable only from the dedicated OpenBot Ops bridge
# address and the Dokploy control network. Never publish a port or Tunnel route.
DOKPLOY_ENABLED_TAGS=project,compose,deployment
DOKPLOY_REDACT_ENV=true
