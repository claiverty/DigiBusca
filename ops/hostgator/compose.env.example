# Non-secret Compose interpolation values. Use the exact immutable SHA tags
# embedded in the CI artifacts after loading those images into the VPS Docker.
DIGIBUSCA_BACKEND_IMAGE=ghcr.io/claiverty/digibusca-backend:REPLACE_WITH_COMMIT_SHA
DIGIBUSCA_EVOLUTION_IMAGE=ghcr.io/claiverty/digibusca-evolution-api:REPLACE_WITH_COMMIT_SHA

# Latest upstream cloudflared release reviewed on 2026-11-18.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.11.1
