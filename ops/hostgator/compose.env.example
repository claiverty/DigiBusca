# Non-secret Compose interpolation values. Backend/Evolution images use the
# immutable SHA tags embedded in CI artifacts. OpenClaw uses an upstream digest.
DIGIBUSCA_BACKEND_IMAGE=ghcr.io/claiverty/digibusca/digibusca-backend:REPLACE_WITH_COMMIT_SHA
DIGIBUSCA_EVOLUTION_IMAGE=ghcr.io/claiverty/digibusca/digibusca-evolution-api:REPLACE_WITH_COMMIT_SHA
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.11.6@sha256:65e229536a2698f0ab211c8a3d1c5c8e2685d19379d153e95f93ff76f22779cf

# Latest upstream cloudflared release reviewed on 2026-11-18.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.11.1

# Caddy public reverse proxy is pinned to the official amd64 image digest.
OPENCLAW_PANEL_PROXY_IMAGE=caddy:2.11.9-alpine@sha256:fc9cbc100585871d18d4e451cca7021785c90a7006087427ae5ceb3e4efe6424
